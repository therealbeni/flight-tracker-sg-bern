# Copy to .env and fill in real values before running `docker compose up`.
POSTGRES_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
# Public URL this app is reachable at - used to build QR-code claim links and
# password-reset emails, so it must match wherever the app is actually deployed.
BASE_URL=http://localhost:8000
# Only if the app is reachable exclusively through a proxy that sets this header
# with the visitor's IP (Cloudflare: cf-connecting-ip; nginx/Caddy usually
# x-forwarded-for). Leave empty otherwise - a client could fake it.
CLIENT_IP_HEADER=
# The club's Vereinsflieger (see docs/vereinsflieger.md). off: no calls at all;
# readonly: only reads (preview); live: the Flugbuch can send flights. Only the
# club server should ever be live - never two servers at once.
VEREINSFLIEGER_MODE=off
# Stammdaten > Einstellungen > REST Interface in Vereinsflieger.
VEREINSFLIEGER_APPKEY=
# The Vereinsflieger login the tracker uses (plain password; it is sent as md5).
VEREINSFLIEGER_USER=
VEREINSFLIEGER_PASSWORD=
# Only if that user is in several clubs / has two-factor authentication.
VEREINSFLIEGER_CID=
VEREINSFLIEGER_AUTH_SECRET=
