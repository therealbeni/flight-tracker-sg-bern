# Copy to .env and fill in real values before running `docker compose up`.
POSTGRES_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
# Public URL this app is reachable at - used to build QR-code claim links and
# password-reset emails, so it must match wherever the app is actually deployed.
BASE_URL=http://localhost:8000
