# Test image: runs the whole pytest suite (app + tracker) without installing
# anything on the host. Used by dev/test.sh - see readme.md "Development".
FROM python:3.12-slim

WORKDIR /src
COPY app/requirements.txt app-requirements.txt
COPY tracker/requirements.txt tracker-requirements.txt
RUN pip install --no-cache-dir -r app-requirements.txt -r tracker-requirements.txt pytest httpx
